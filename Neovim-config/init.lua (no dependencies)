-- The commented plugins need extra programs to work. Check their "Needs:" comment and the README
vim.pack.add({
    -- Vim-Airline. It makes nvim more beautiful and informational.
    'https://github.com/vim-airline/vim-airline',

    -- NERDTree. :NERDTree. You can see the directories and files in a tree (like File Explorer). Main usage: Alt+f.
    'https://github.com/preservim/nerdtree',

    -- Vim-css-color. It highlights a hexadecimal representation of color (example #2f6a43).
    'https://github.com/ap/vim-css-color',

    -- Vim-devicons. It adds an icon for the file extensions (for example, the python logo for python files).
    -- Needs: a Nerd Font in the terminal (WezTerm already includes one, you can uncomment the next line if you use WezTerm).
    -- 'https://github.com/ryanoasis/vim-devicons',

    -- Tagbar. :Tagbar. It provides information about the classes, attributes, methods, functions and variables of a file. Main usage: Alt+g.
    -- Needs: ctags.
    -- 'https://github.com/preservim/tagbar',

    -- Vim-visual-multi. You can have multiple cursors. Main usage: Ctrl+n; Ctrl+ArrowUp/Down; Shift+ArrowLeft/Right; Ctrl+MouseLeftClick.
    'https://github.com/mg979/vim-visual-multi',

    -- Treesitter. Syntax highlighting and colors.
    -- Needs: a C compiler and the tree-sitter CLI.
    -- 'https://github.com/nvim-treesitter/nvim-treesitter',

    -- Blink.cmp. Autocompletion engine tracking to the latest tagged version (because the main branch is under active development right now in September 2026 and they have releases in the tag format).
    { src = 'https://github.com/saghen/blink.cmp', version = vim.version.range('*') },

    -- Friendly-snippets. It provides snippets for the languages, like type for in Python, get a for-loop skeleton.
    'https://github.com/rafamadriz/friendly-snippets',

    -- nvim-lspconfig. It provides pre-made lsp server configs, so I don't have to write them by myself. Neovim's native vim.lsp.config()/vim.lsp.enable() pick up them automatically.
    'https://github.com/neovim/nvim-lspconfig',

    -- mason.nvim. It provides the language server binaries, plus linters, formatters, and debuggers. It downloads them into Neovim's own data folder and quietly adds them to your $PATH, so I never have to think about "how do I install pyright on this machine.". It's pinned to the latest tagged version due to their releases policy.
    { src = 'https://github.com/mason-org/mason.nvim', version = vim.version.range('*') },

    -- mason-lspconfig.nvim. It's the bridge between nvim-lspconfig and mason.nvim, so I don't have to maintain the union of both and it's much more automatically/easy. It's pinned to the latest tag version due to their releases policy.
    { src = 'https://github.com/mason-org/mason-lspconfig.nvim', version = vim.version.range('*') },

    -- lazydev.nvim. Configure automatically the global variables and autocompletion of the Neovim files, like vim variable here in the Neovim config for example.
    { src = 'https://github.com/folke/lazydev.nvim', version = vim.version.range('*') },
})



