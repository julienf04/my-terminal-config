-----------------------------------
----- blink.cmp
-----------------------------------

-- Autocompletion. 'default' keymap preset: <C-space> opens the menu, Up/Down or <C-n>/<C-p>
-- navigate, <CR> accepts, <C-e> cancels. The 'lsp' source will show LSP-powered completions
-- once you have a language server attached (see note below) 
require('blink.cmp').setup({
    keymap = { preset = 'super-tab' },
    sources = {
	default = { 'lazydev', 'lsp', 'snippets', 'path', 'buffer' },
	providers = {
	    lazydev = {
		name = "LazyDev",
		module = "lazydev.integrations.blink",
		score_offset = 100, -- make lazydev completions top priority (see `:h blink.cmp`).
	    },
	},
    },
})


-----------------------------------
----- mason.nvim and mason-lspconfig.nvim
-----------------------------------

-- mason.nvim and mason-lspconfig.nvim
-- mason.nvim installs the actual language server binaries; mason-lspconfig.nvim bridges them to
-- nvim-lspconfig's server configs and automatically calls vim.lsp.enable() for whatever you list
-- in ensure_installed
require('mason').setup()
require('mason-lspconfig').setup({
  ensure_installed = { 'lua_ls', 'bashls', 'jdtls' }, -- starter set: Lua (for this config) + Bash. Add more server names as you need them.
})

-- Give every LSP server blink.cmp's completion capabilities (snippets, richer completion info,
-- etc.) by default, via the special '*' key that vim.lsp.config treats as shared defaults.
vim.lsp.config('*', {
  capabilities = require('blink.cmp').get_lsp_capabilities(),
})


