-- Clipboard.
-- I define the copy and paste behaviour (that's calling the Windows clipboard feature). It only
-- works on WSL. If you're using a native Linux, the behaviour has to be different.
vim.g.clipboard = {
  name = 'WslClipboard',
  copy = {
    ['+'] = 'clip.exe',
    ['*'] = 'clip.exe',
  },
  paste = {
    ['+'] = 'powershell.exe -NoLogo -NoProfile -c [Console]::Out.Write($(Get-Clipboard -Raw).toString().replace("`r", ""))',
    ['*'] = 'powershell.exe -NoLogo -Noprofile -c [Console]::Out.Write($(Get-Clipboard -Raw).toString().replace("`r", ""))',
  },
  cache_enabled = 0,
}

-- It uses the system clipboard for yank and paste operations.
vim.opt.clipboard:append('unnamedplus') 


-----------------------------------------------------------------------
---------- Keybindings
-----------------------------------------------------------------------

-- Invert horizontal mouse/touchpad scrolling
vim.keymap.set({ 'n', 'v', 'i' }, '<ScrollWheelLeft>', '<ScrollWheelRight>')
vim.keymap.set({ 'n', 'v', 'i' }, '<ScrollWheelRight>', '<ScrollWheelLeft>')

-- Copy with Ctrl+c
vim.keymap.set('v', '<C-c>', '"+y')

-- Cut with Ctrl+x
vim.keymap.set('v', '<C-x>', '"+d')

-- Undo with Ctrl+z in Normal, Insert and Visual modes.
-- Note. Ctrl+z sends '\x2f' signal in my system due to my terminal config, not the default
-- '\x2a'. That means I have to keybind <C-_> ('\x1a' signal) for the Ctrl+z behaviour.
vim.keymap.set('n', '<C-_>', 'u')
vim.keymap.set('i', '<C-_>', '<C-o>u')
vim.keymap.set('v', '<C-_>', 'u')

-- Redo with Ctrl+y in Normal, Insert and Visual modes.
vim.keymap.set('n', '<C-y>', '<C-r>')
vim.keymap.set('i', '<C-y>', '<C-o><C-r>')
vim.keymap.set('v', '<C-y>', '<C-r>')

-- Select all with Ctrl+a in Normal, Insert and Visual modes.
vim.keymap.set('n', '<C-a>', 'ggVG')
vim.keymap.set('i', '<C-a>', '<Esc>ggVG')
vim.keymap.set('v', '<C-a>', 'ggVG')

-- Ctrl+Shift+f (WezTerm sends it as Alt+/): search the whole file.
-- From insert/visual mode, drop to normal mode first so Enter and Esc work as described below.
vim.keymap.set('n', '<A-/>', '/')
vim.keymap.set({ 'i', 'v' }, '<A-/>', '<Esc>/')

-- Enter: while search highlighting is showing, jump to the next match; otherwise behave as usual.
-- (Only in regular file buffers, so Enter keeps working in quickfix, the command-line window, etc.)
vim.keymap.set('n', '<CR>', function()
  if vim.v.hlsearch == 1 and vim.bo.buftype == '' then
    return 'n'
  end
  return '<CR>'
end, { expr = true })

-- Esc: clear the search highlighting
vim.keymap.set('n', '<Esc>', '<Cmd>nohlsearch<CR>')

--########## Note for the Paste clipboard feature or Ctrl+v
-- If the paste feature (Ctrl+v) doesn't work for you by default, try uncommenting the following
-- mapping. I have it commented because it works fine for me by default due to other configs in
-- my terminal.
-- vim.keymap.set('v', '<C-v>', '"+p')

--########## For the next keybindings:
-- Some Ctrl+key combinations aren't reliably distinguishable from their terminal input sequences
-- in Neovim. My terminal translates these Ctrl shortcuts into equivalent Alt shortcuts, which
-- Neovim can recognize reliably. These mappings register those Alt sequences and define their
-- behavior in each relevant mode.

-- Register Alt+Backspace
vim.cmd([[execute "set <A-BS>=\<Esc>\<BS>"]])
-- Delete word before cursor
vim.keymap.set('i', '<A-BS>', '<C-w>')

-- Register Alt+b
vim.cmd([[execute "set <A-b>=\<Esc>b"]])
-- Move back one word (Normal mode)
vim.keymap.set('n', '<A-b>', 'b')
-- Move back one word (Insert mode)
vim.keymap.set('i', '<A-b>', '<C-o>b')
-- Move back one word (Visual mode)
vim.keymap.set('v', '<A-b>', 'b')

-- Register Alt+f
vim.cmd([[execute "set <A-f>=\<Esc>f"]])
-- Move forward one word (Normal mode)
vim.keymap.set('n', '<A-f>', 'w')
-- Move forward one word (Insert mode)
vim.keymap.set('i', '<A-f>', '<C-o>w')
-- Move forward one word (Visual mode)
vim.keymap.set('v', '<A-f>', 'w')



